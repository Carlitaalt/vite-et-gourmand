# Copier ce fichier en .env puis renseigner les valeurs (elles peuvent être arbitraires en local).
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Port local du site (http://localhost:8080) et URL utilisée dans les liens des e-mails
APP_PORT=8080
APP_URL=http://localhost:8080

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=vg_user
DB_PASSWORD=change_moi
MYSQL_ROOT_PASSWORD=change_moi_root

# MongoDB (statistiques de commandes)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=vite_gourmand

# E-mails : en local, Mailpit intercepte tous les messages (interface : http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM=noreply@vite-gourmand.fr
MAIL_CONTACT=contact@vite-gourmand.fr
